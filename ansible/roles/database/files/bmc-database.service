[Unit]
Description=BMC database (data volume, secrets, MySQL and exporter)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
ConditionPathExists=/etc/bmc/database.env

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=900
ExecStart=/opt/bmc/bin/bootstrap.sh
ExecStop=/usr/bin/docker compose -f /opt/bmc/compose.yaml down

[Install]
WantedBy=multi-user.target
