// Managed by Ansible (ansible/roles/alloy); local changes are overwritten.
// Collects this host's metrics and pushes them to Prometheus on the
// monitoring host ({{ monitoring_ip }}:9090, remote write){% if alloy_logs %}, and its logs to
// Loki there ({{ monitoring_ip }}:3100){% endif %}.

prometheus.exporter.unix "host" { }

prometheus.scrape "host" {
  targets         = prometheus.exporter.unix.host.targets
  scrape_interval = "{{ alloy_scrape_interval }}"
  forward_to      = [prometheus.remote_write.monitoring.receiver]
}
{% if alloy_docker_metrics %}

prometheus.exporter.cadvisor "docker" {
  docker_host      = "unix:///var/run/docker.sock"
  storage_duration = "5m"
}

prometheus.scrape "docker" {
  targets         = prometheus.exporter.cadvisor.docker.targets
  scrape_interval = "{{ alloy_scrape_interval }}"
  forward_to      = [prometheus.remote_write.monitoring.receiver]
}
{% endif %}
{% if alloy_mysql_dsn_file %}

// MySQL metrics, Alloy's built-in exporter (no separate mysqld_exporter).
local.file "mysql_dsn" {
  filename  = "{{ alloy_mysql_dsn_file }}"
  is_secret = true
}

prometheus.exporter.mysql "mysql" {
  data_source_name = local.file.mysql_dsn.content
}

prometheus.scrape "mysql" {
  targets         = prometheus.exporter.mysql.mysql.targets
  job_name        = "mysql"
  scrape_interval = "{{ alloy_scrape_interval }}"
  forward_to      = [prometheus.remote_write.monitoring.receiver]
}
{% endif %}
{% for target in alloy_scrape_targets %}

prometheus.scrape "{{ target.name }}" {
  targets         = [{"__address__" = "{{ target.address }}"}]
  job_name        = "{{ target.name }}"
  scrape_interval = "{{ alloy_scrape_interval }}"
  forward_to      = [prometheus.remote_write.monitoring.receiver]
}
{% endfor %}

{% if alloy_logs %}
// --- Logs ------------------------------------------------------------------

// System journal: services, boot, sudo, SSM, the deploy and bootstrap scripts.
loki.relabel "journal" {
  forward_to = []

  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }
  rule {
    source_labels = ["__journal_priority_keyword"]
    target_label  = "level"
  }
}

loki.source.journal "system" {
  max_age       = "{{ alloy_journal_max_age }}"
  relabel_rules = loki.relabel.journal.rules
  labels        = { job = "journal" }
  forward_to    = [loki.write.monitoring.receiver]
}
{% if alloy_docker_metrics %}

// Containers' logs (stdout and stderr), labelled by container name.
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
}

loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.containers.output
  labels     = { job = "docker" }
  forward_to = [loki.write.monitoring.receiver]
}
{% endif %}

loki.write "monitoring" {
  endpoint {
    url = "http://{{ monitoring_ip }}:3100/loki/api/v1/push"
  }
  external_labels = {
    host        = "{{ inventory_hostname }}",
    role        = "{{ group_names | reject('in', ['all', 'aws_ec2']) | sort | first | default('unknown') }}",
    environment = "{{ bmc_environment }}",
  }
}

{% endif %}
prometheus.remote_write "monitoring" {
  endpoint {
    url = "http://{{ monitoring_ip }}:9090/api/v1/write"
  }
  external_labels = {
    host        = "{{ inventory_hostname }}",
    role        = "{{ group_names | reject('in', ['all', 'aws_ec2']) | sort | first | default('unknown') }}",
    environment = "{{ bmc_environment }}",
  }
}
