# Managed by Ansible (ansible/roles/app). Read by /usr/local/bin/bmc-app-deploy.
# No secrets here: passwords are read from Parameter Store at deploy time.
AWS_REGION={{ aws_region }}
BMC_ENVIRONMENT={{ bmc_environment }}
BMC_DB_HOST={{ app_database_host }}
BMC_DB_USERS_PREFIX=/bmc/{{ bmc_environment }}/database/users
BMC_DATABASES="{{ app_databases | join(' ') }}"
