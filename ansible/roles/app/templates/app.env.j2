# Managed by Ansible (ansible/roles/app). Read by /usr/local/bin/bmc-app-deploy
# and /usr/local/bin/bmc-duckdns-update.
# No secrets here: passwords and tokens are read from Parameter Store when used.
AWS_REGION={{ aws_region }}
BMC_ENVIRONMENT={{ bmc_environment }}
BMC_PARAMETER_PREFIX=/bmc/{{ bmc_environment }}/app
BMC_PUBLIC_HOST={{ app_public_host }}
BMC_DUCKDNS_DOMAIN={{ app_duckdns_domain }}
BMC_DB_HOST={{ app_database_host }}
BMC_DB_USERS_PREFIX=/bmc/{{ bmc_environment }}/database/users
BMC_DATABASES="{{ app_databases | join(' ') }}"
BMC_APP_SECRETS="{{ app_secrets | join(' ') }}"
